* { font-family: "Segoe UI"; font-size: 12px; color: {{TEXT}}; }
QMainWindow, QWidget#Root { background: {{BG_APP}}; }
QFrame#Panel, QFrame#Metric, QFrame#Toolbar { background: {{BG_PANEL}}; border: 1px solid {{BORDER}}; border-radius: 12px; }
QFrame#Card { background: {{BG_PANEL_ALT}}; border: 1px solid {{BORDER}}; border-radius: 8px; }
QFrame#Card:hover { border-color: {{ACCENT}}; }
QFrame#Card[sel="true"] { background: {{BG_HOVER}}; border: 1px solid {{ACCENT}}; }
QLabel { background: transparent; }
QLabel#PanelTitle { color: {{TEXT_MUTED}}; font-size: 11px; font-weight: 700; }
QLabel#Muted { color: {{TEXT_MUTED}}; }
QLabel#Title { font-size: 29px; font-weight: 700; }
QLabel#Big { font-size: 21px; font-weight: 700; }
QLabel#MetricValue { font-size: 30px; font-weight: 700; }
QLabel#Brand { background: {{ACCENT}}; color: {{TEXT_ON_ACCENT}}; border-radius: 12px; font-size: 20px; font-weight: 800; }
QLabel#State { color: {{ACCENT}}; background: {{BG_PANEL_ALT}}; border: 1px solid {{BORDER}}; border-radius: 12px; padding: 7px 14px; font-weight: 600; }
QLabel#Badge { color: {{TEXT_ON_ACCENT}}; font-weight: 700; font-size: 16px; border-radius: 10px; }
QPushButton { background: {{BG_PANEL_ALT}}; border: 1px solid {{BORDER}}; border-radius: 7px; padding: 8px 13px; font-weight: 600; }
QPushButton:hover:enabled { background: {{BG_HOVER}}; border-color: {{ACCENT}}; }
QPushButton:checked { background: {{BG_HOVER}}; color: {{ACCENT}}; border-color: {{ACCENT}}; }
QPushButton:checked:hover:enabled { background: {{BORDER}}; }
QPushButton:pressed:enabled { background: {{BG_INPUT}}; border-color: {{ACCENT}}; padding-top: 9px; padding-bottom: 7px; }
QPushButton#Primary { background: {{ACCENT}}; color: {{TEXT_ON_ACCENT}}; border-color: {{ACCENT}}; }
QPushButton#Primary:hover:enabled { background: {{ACCENT_HOVER}}; border-color: {{ACCENT_HOVER}}; }
QPushButton#Primary:pressed:enabled { background: {{ACCENT_PRESSED}}; border-color: {{ACCENT_PRESSED}}; }
QPushButton#Danger:hover:enabled { color: {{DANGER}}; border-color: {{DANGER}}; }
QPushButton#Danger:pressed:enabled { background: {{DANGER}}; color: {{TEXT_ON_ACCENT}}; border-color: {{DANGER}}; }
QPushButton:disabled, QPushButton#Primary:disabled, QPushButton#Danger:disabled {
    color: {{TEXT_MUTED}};
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 {{BG_HOVER}},stop:1 {{BG_PANEL_ALT}});
    border-color: {{BORDER}};
    border-top-color: {{DISABLED_EDGE}};
    border-bottom-color: {{BG_INPUT}};
}
QPushButton:disabled[cursorEncima="true"], QPushButton#Primary:disabled[cursorEncima="true"], QPushButton#Danger:disabled[cursorEncima="true"] {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 {{BORDER}},stop:1 {{BG_HOVER}});
    border-color: {{DISABLED_EDGE}};
    border-top-color: {{TEXT_MUTED}};
    border-bottom-color: {{BORDER}};
}
QLineEdit, QComboBox, QSpinBox { background: {{BG_INPUT}}; border: 1px solid {{BORDER}}; border-radius: 6px; padding: 7px 8px; selection-background-color: {{BG_HOVER}}; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border-color: {{ACCENT}}; }
QComboBox QAbstractItemView { background: {{BG_PANEL}}; selection-background-color: {{BG_HOVER}}; border: 1px solid {{BORDER}}; }
QProgressBar { background: {{BG_INPUT}}; border: none; border-radius: 4px; text-align: center; font-size: 10px; }
QProgressBar::chunk { background: {{ACCENT}}; border-radius: 4px; }
QProgressBar#TotalProgress::chunk { background: {{STATE_PREPARADO}}; }
QScrollArea { background: transparent; border: none; }
QScrollArea > QWidget > QWidget { background: transparent; }
QScrollBar:vertical { background: transparent; width: 8px; }
QScrollBar::handle:vertical { background: {{BORDER}}; border-radius: 4px; min-height: 24px; }
QScrollBar:horizontal { background: {{BG_INPUT}}; height: 14px; border-radius: 7px; }
QScrollBar::handle:horizontal { background: {{TEXT_MUTED}}; border-radius: 6px; min-width: 40px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QTabWidget::pane { background: {{BG_PANEL}}; border: 1px solid {{BORDER}}; border-radius: 10px; top: -1px; }
QTabBar::tab { color: {{TEXT_MUTED}}; padding: 10px 12px; border-bottom: 2px solid transparent; }
QTabBar::tab:selected { color: {{ACCENT}}; border-bottom-color: {{ACCENT}}; }
QTabBar::tab:hover { color: {{TEXT}}; }
QToolTip { background: {{TOOLTIP_BG}}; color: {{TOOLTIP_TEXT}}; border: 1px solid {{BORDER}}; padding: 8px; }
QSplitter::handle { background: {{BG_APP}}; }
QSplitter::handle:hover { background: {{BORDER}}; }
QStatusBar { background: {{BG_APP}}; color: {{TEXT_MUTED}}; font-size: 11px; }

QWidget#Hero { background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 {{HERO_START}},stop:1 {{HERO_END}}); border: 1px solid {{BORDER}}; border-radius: 18px; }
QLabel#Eyebrow { color: {{ACCENT}}; font-size: 10px; font-weight: 700; letter-spacing: 2px; }
QFrame#Toolbar { background: {{BG_PANEL_ALT}}; border-radius: 14px; }
QFrame#Panel { border-radius: 14px; }
QLabel#PanelTitle { color: {{TEXT}}; padding-bottom: 4px; }
QPushButton { min-height: 18px; }
QPushButton:focus, QComboBox:focus { border: 1px solid {{ACCENT}}; }
QCheckBox { spacing: 7px; color: {{TEXT_MUTED}}; }
QCheckBox::indicator { width: 15px; height: 15px; border: 1px solid {{BORDER}}; border-radius: 4px; background: {{BG_INPUT}}; }
QCheckBox::indicator:checked { background: {{ACCENT}}; border-color: {{ACCENT}}; }
QScrollBar::handle:horizontal:hover, QScrollBar::handle:vertical:hover { background: {{ACCENT}}; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QTabBar::tab:selected { background: {{BG_PANEL_ALT}}; border-top-left-radius: 8px; border-top-right-radius: 8px; }
